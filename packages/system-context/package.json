{
	"name": "@pidev/system-context",
	"version": "0.1.0",
	"description": "Pi extension + script. Views the assembled system prompt in-session, and captures any project's prompt to a file via the SDK.",
	"keywords": [
		"pi-package",
		"pidev",
		"system-prompt",
		"sdk"
	],
	"type": "module",
	"license": "Apache-2.0",
	"author": "pidev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mcwalrus/pidev-mono.git",
		"directory": "packages/system-context"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dump": "node --experimental-strip-types dump.ts",
		"test": "vitest run"
	},
	"files": [
		"dump.ts",
		"index.ts",
		"footprint.ts",
		"overlay.ts",
		"script.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": "./index.ts",
		"./dump": "./dump.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	}
}
