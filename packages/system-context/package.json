{
	"name": "@pidev/system-context",
	"version": "0.1.0",
	"description": "Script. Dumps the system-context prompt Pi builds for a project via the SDK, including its extensions, skills and MCP tools.",
	"keywords": [
		"pi-package",
		"pidev",
		"system-prompt",
		"sdk"
	],
	"type": "module",
	"license": "Apache-2.0",
	"author": "pidev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mcwalrus/pidev-mono.git",
		"directory": "packages/system-context"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dump": "node --experimental-strip-types dump.ts",
		"test": "vitest run"
	},
	"files": [
		"dump.ts",
		"index.ts",
		"overlay.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": "./index.ts",
		"./dump": "./dump.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	}
}
